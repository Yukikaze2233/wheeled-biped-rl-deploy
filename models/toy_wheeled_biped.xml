<?xml version="1.0" ?>
<!-- Toy wheeled biped for sim2sim LOOP VALIDATION ONLY (not a real robot).
     Joint names follow the deploy contract so obs/action mapping runs
     end-to-end: 4 leg hinges + 2 wheel hinges + torso free joint.
     Swap in the real MJCF (converted from URDF) for actual sim2sim checks. -->
<mujoco model="toy_wheeled_biped">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" friction="1.0"/>
    <body name="torso" pos="0 0 0.30">
      <freejoint name="root"/>
      <geom name="torso_box" type="box" size="0.15 0.10 0.05" mass="4.0" friction="0.6"/>
      <!-- left leg: two hinge joints (front1/rear1) with capsule links -->
      <body name="left_front1" pos="0.10 -0.10 -0.05">
        <joint name="left_front1_joint" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.12" size="0.015" mass="0.3"/>
      </body>
      <body name="left_rear1" pos="-0.10 -0.10 -0.05">
        <joint name="left_rear1_joint" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.12" size="0.015" mass="0.3"/>
      </body>
      <body name="left_wheel" pos="0 -0.14 -0.20">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.06 0.02" quat="0.7071 0.7071 0 0"
              mass="0.4" friction="1.0"/>
      </body>
      <!-- right leg -->
      <body name="right_front1" pos="0.10 0.10 -0.05">
        <joint name="right_front1_joint" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.12" size="0.015" mass="0.3"/>
      </body>
      <body name="right_rear1" pos="-0.10 0.10 -0.05">
        <joint name="right_rear1_joint" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.12" size="0.015" mass="0.3"/>
      </body>
      <body name="right_wheel" pos="0 0.14 -0.20">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.06 0.02" quat="0.7071 0.7071 0 0"
              mass="0.4" friction="1.0"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="left_front1" joint="left_front1_joint" ctrlrange="-40 40"/>
    <motor name="right_front1" joint="right_front1_joint" ctrlrange="-40 40"/>
    <motor name="left_rear1" joint="left_rear1_joint" ctrlrange="-40 40"/>
    <motor name="right_rear1" joint="right_rear1_joint" ctrlrange="-40 40"/>
    <motor name="left_wheel" joint="left_wheel_joint" ctrlrange="-5 5"/>
    <motor name="right_wheel" joint="right_wheel_joint" ctrlrange="-5 5"/>
  </actuator>
</mujoco>
